
#!/usr/bin/env bash
set -Eeuo pipefail

# ============================================================
# OpenTV PS3 - Descarga y verificacion de dependencias
# Descarga FAAD2 y mbedTLS.
# NO compila ni instala bibliotecas.
# ============================================================

BUILD_ROOT="${PS3_BUILD_ROOT:?ERROR: PS3_BUILD_ROOT no esta definido}"

# FAAD2: commit fijado para mantener una version reproducible.
FAAD_REPO="https://github.com/knik0/faad2.git"
FAAD_COMMIT="a335040022e14ff9b6c54bbd459590d4c7edffe8"

# mbedTLS: version fijada.
MBED_REPO="https://github.com/Mbed-TLS/mbedtls.git"
MBED_TAG="v3.6.2"

FAAD_DIR="$BUILD_ROOT/faad2"
MBED_DIR="$BUILD_ROOT/mbedtls"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PS3_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG="$PS3_ROOT/third_party/ot_mbedtls_config.h"

mkdir -p "$BUILD_ROOT"

echo "============================================"
echo " OpenTV PS3 - Descarga de dependencias"
echo "============================================"

# ------------------------------------------------------------
# 1. FAAD2
# ------------------------------------------------------------

echo
echo "1. Descargando FAAD2..."

rm -rf "$FAAD_DIR"

mkdir -p "$FAAD_DIR"

git -C "$FAAD_DIR" init
git -C "$FAAD_DIR" remote add origin "$FAAD_REPO"

if ! git -C "$FAAD_DIR" fetch --depth 1 origin "$FAAD_COMMIT"; then
    echo "ERROR: no se pudo descargar el commit fijado de FAAD2."
    echo "Commit: $FAAD_COMMIT"
    echo "No se utilizara otra version automaticamente."
    exit 1
fi

git -C "$FAAD_DIR" checkout --detach FETCH_HEAD

if [ ! -f "$FAAD_DIR/CMakeLists.txt" ]; then
    echo "ERROR: falta CMakeLists.txt en FAAD2."
    exit 1
fi

if [ ! -f "$FAAD_DIR/include/neaacdec.h" ]; then
    echo "ERROR: falta include/neaacdec.h en FAAD2."
    exit 1
fi

ACTUAL_FAAD="$(git -C "$FAAD_DIR" rev-parse HEAD)"

if [ "$ACTUAL_FAAD" != "$FAAD_COMMIT" ]; then
    echo "ERROR: el commit descargado de FAAD2 no coincide."
    exit 1
fi

echo "[OK] FAAD2 descargado."
echo "Commit: $ACTUAL_FAAD"

# ------------------------------------------------------------
# 2. mbedTLS
# ------------------------------------------------------------

echo
echo "2. Descargando mbedTLS..."

rm -rf "$MBED_DIR"

if ! git clone \
    --branch "$MBED_TAG" \
    --depth 1 \
    "$MBED_REPO" \
    "$MBED_DIR"; then
    echo "ERROR: no se pudo descargar mbedTLS $MBED_TAG."
    exit 1
fi

if [ ! -f "$MBED_DIR/CMakeLists.txt" ]; then
    echo "ERROR: falta CMakeLists.txt en mbedTLS."
    exit 1
fi

if [ ! -f "$MBED_DIR/include/mbedtls/ssl.h" ]; then
    echo "ERROR: faltan los headers de mbedTLS."
    exit 1
fi

ACTUAL_MBED="$(git -C "$MBED_DIR" describe --tags --exact-match)"

if [ "$ACTUAL_MBED" != "$MBED_TAG" ]; then
    echo "ERROR: la version descargada de mbedTLS no coincide."
    exit 1
fi

echo "[OK] mbedTLS descargado."
echo "Version: $ACTUAL_MBED"

# ------------------------------------------------------------
# 3. Configuracion OpenTV
# ------------------------------------------------------------

echo
echo "3. Comprobando configuracion OpenTV..."

if [ ! -f "$CONFIG" ]; then
    echo "ERROR: falta ot_mbedtls_config.h:"
    echo "$CONFIG"
    exit 1
fi

echo "[OK] Configuracion encontrada:"
echo "$CONFIG"

# ------------------------------------------------------------
# 4. Guardar informacion de versiones
# ------------------------------------------------------------

echo
echo "4. Guardando versiones..."

cat > "$BUILD_ROOT/deps-versions.txt" <<EOF
FAAD2_REPOSITORY=$FAAD_REPO
FAAD2_COMMIT=$ACTUAL_FAAD
MBEDTLS_REPOSITORY=$MBED_REPO
MBEDTLS_VERSION=$ACTUAL_MBED
EOF

echo "[OK] Versiones guardadas."

# ------------------------------------------------------------
# 5. Resultado
# ------------------------------------------------------------

echo
echo "============================================"
echo " DESCARGA COMPLETADA"
echo "============================================"
echo "FAAD2:   $FAAD_DIR"
echo "mbedTLS: $MBED_DIR"
echo "Config:  $CONFIG"
echo
echo "Las fuentes estan descargadas."
echo "Las bibliotecas todavia NO estan compiladas."
