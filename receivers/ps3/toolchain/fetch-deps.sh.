
#!/usr/bin/env bash
set -Eeuo pipefail

# ============================================================
# OpenTV PS3 - Descarga y verificacion de dependencias
# Esta fase NO compila ni instala bibliotecas.
# ============================================================

BUILD_ROOT="${PS3_BUILD_ROOT:?ERROR: PS3_BUILD_ROOT no esta definido}"

FAAD_REPO="https://github.com/knik0/faad2.git"
FAAD_COMMIT="a335040022e14ff9b6c54bbd459590d4c7edffe8"

MBED_REPO="https://github.com/Mbed-TLS/mbedtls.git"
MBED_TAG="v3.6.2"

FAAD_DIR="$BUILD_ROOT/faad2"
MBED_DIR="$BUILD_ROOT/mbedtls"

mkdir -p "$BUILD_ROOT"

echo "============================================"
echo " OpenTV PS3 - Descarga de dependencias"
echo "============================================"

# ------------------------------------------------------------
# FAAD2
# ------------------------------------------------------------

echo
echo "1. Descargando FAAD2..."

if [ -d "$FAAD_DIR/.git" ]; then
    echo "Repositorio FAAD2 existente."
else
    rm -rf "$FAAD_DIR"
    git clone "$FAAD_REPO" "$FAAD_DIR"
fi

git -C "$FAAD_DIR" fetch origin "$FAAD_COMMIT"
git -C "$FAAD_DIR" checkout --detach "$FAAD_COMMIT"

if [ ! -f "$FAAD_DIR/include/neaacdec.h" ]; then
    echo "ERROR: no se encontro include/neaacdec.h en FAAD2."
    exit 1
fi

echo "FAAD2 descargado:"
git -C "$FAAD_DIR" rev-parse HEAD

# ------------------------------------------------------------
# mbedTLS
# ------------------------------------------------------------

echo
echo "2. Descargando mbedTLS..."

if [ -d "$MBED_DIR/.git" ]; then
    echo "Repositorio mbedTLS existente."
else
    rm -rf "$MBED_DIR"
    git clone --branch "$MBED_TAG" --depth 1 "$MBED_REPO" "$MBED_DIR"
fi

if [ ! -f "$MBED_DIR/CMakeLists.txt" ]; then
    echo "ERROR: no se encontro CMakeLists.txt en mbedTLS."
    exit 1
fi

if [ ! -f "$MBED_DIR/include/mbedtls/build_info.h" ]; then
    echo "ERROR: faltan los headers de mbedTLS."
    exit 1
fi

echo "mbedTLS descargado:"
git -C "$MBED_DIR" describe --tags --exact-match

# ------------------------------------------------------------
# Configuracion OpenTV
# ------------------------------------------------------------

echo
echo "3. Comprobando configuracion OpenTV..."

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PS3_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG="$PS3_ROOT/third_party/ot_mbedtls_config.h"

if [ ! -f "$CONFIG" ]; then
    echo "ERROR: falta ot_mbedtls_config.h: $CONFIG"
    exit 1
fi

echo "Configuracion encontrada: $CONFIG"

# ------------------------------------------------------------
# Resultado
# ------------------------------------------------------------

echo
echo "============================================"
echo " DESCARGA COMPLETADA"
echo "============================================"
echo "FAAD2:   $FAAD_DIR"
echo "mbedTLS: $MBED_DIR"
echo
echo "IMPORTANTE: las bibliotecas todavia NO estan compiladas."
